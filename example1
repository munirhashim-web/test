"""
FastAPI backend — serves the web chat UI and exposes a REST endpoint.
Telegram webhook is handled in telegram_bot.py and mounted here.
"""
import os
import uuid
from fastapi import FastAPI, HTTPException
from fastapi.staticfiles import StaticFiles
from fastapi.responses import FileResponse
from pydantic import BaseModel

from bot.chat_engine import chat, reset_failures

app = FastAPI(title="Study Buddy Bot — Web API")

# In-memory session history store (replace with Redis for production)
_sessions: dict[str, list[dict]] = {}

ESCALATION_MESSAGE = (
    "🙋 You're being connected to a teacher or mentor who can better assist you. "
    "Please reach out to your school support team directly."
)


# ── Pydantic models ──────────────────────────────────────────────────────────

class MessageRequest(BaseModel):
    session_id: str | None = None   # If None, a new session is created
    message: str


class MessageResponse(BaseModel):
    session_id: str
    reply: str
    escalated: bool


# ── Chat endpoint ────────────────────────────────────────────────────────────

@app.post("/api/chat", response_model=MessageResponse)
async def api_chat(req: MessageRequest):
    if not req.message.strip():
        raise HTTPException(status_code=400, detail="Message cannot be empty.")

    session_id = req.session_id or str(uuid.uuid4())
    history = _sessions.get(session_id, [])

    result = chat(session_id=session_id, history=history, user_message=req.message)

    # Persist the exchange to session history
    history.append({"role": "user", "content": req.message})
    history.append({"role": "assistant", "content": result["reply"]})
    _sessions[session_id] = history[-40:]  # keep last 20 exchanges (40 msgs)

    reply = result["reply"]
    if result["escalate"]:
        reply += f"\n\n{ESCALATION_MESSAGE}"
        reset_failures(session_id)

    return MessageResponse(
        session_id=session_id,
        reply=reply,
        escalated=result["escalate"],
    )


@app.delete("/api/chat/{session_id}")
async def clear_session(session_id: str):
    """Clear a session's history (e.g. when user starts over)."""
    _sessions.pop(session_id, None)
    reset_failures(session_id)
    return {"status": "cleared"}


# ── Serve the web frontend ───────────────────────────────────────────────────

app.mount("/static", StaticFiles(directory="static"), name="static")


@app.get("/")
async def serve_index():
    return FileResponse("static/index.html")
